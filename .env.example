# Скрытые страницы: /results и /questions
# Открываются так: /results?login=...&password=...
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Postgres (Neon, Supabase или Vercel Postgres).
# На Vercel без этой переменной ответы не сохраняются.
# Локально можно оставить пустым — данные пишутся в data/db.json
DATABASE_URL=
